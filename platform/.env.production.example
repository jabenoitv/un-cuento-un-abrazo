# ROANSO SpA — Variables de Entorno de Producción (Control Plane VPS + Nodos GPU Arrendados)
ROANSO_ENVIRONMENT=prod
POSTGRES_USER=roanso
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_POSTGRES_SEGURO
POSTGRES_DB=roanso_prod

ROANSO_DATABASE_URL=postgresql+psycopg://roanso:CAMBIAR_PASSWORD_POSTGRES_SEGURO@postgres:5432/roanso_prod
ROANSO_JWT_SECRET_KEY=GENERAR_CON_python_-c_import_secrets_print_secrets_token_urlsafe_48

# Generar con: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ROANSO_VOICE_VAULT_MASTER_KEY_B64=REEMPLAZAR_CLAVE_MAESTRA_AES256_DE_32_BYTES_B64
ROANSO_WORKER_SHARED_TOKEN=GENERAR_TOKEN_HMAC_COMPARTIDO_CON_RUNPOD_WORKERS

# Cloudflare R2 (cero costo de egreso para streaming MP3) o MinIO / AWS S3
ROANSO_STORAGE_BACKEND=s3
ROANSO_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
ROANSO_S3_BUCKET=roanso-cuentos-prod
ROANSO_S3_ACCESS_KEY=REEMPLAZAR_R2_ACCESS_KEY
ROANSO_S3_SECRET_KEY=REEMPLAZAR_R2_SECRET_KEY
ROANSO_S3_REGION=auto
